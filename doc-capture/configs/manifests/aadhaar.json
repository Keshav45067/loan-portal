{
  "document_id": "aadhaar",
  "title": { "English": "Aadhaar Card", "Hindi": "आधार कार्ड" },
  "proves": ["identity", "address"],
  "required_when": "always",
  "expects": ["doc_aadhaar_name", "doc_aadhaar_dob", "doc_aadhaar_gender", "doc_aadhaar_last4", "doc_aadhaar_address"],
  "parts": [
    {
      "id": "front",
      "name": { "English": "Front Side", "Hindi": "सामने का हिस्सा" },
      "title": { "English": "front side", "Hindi": "सामने का हिस्सा" },
      "anchors": ["Government of India", "DOB", "Year of Birth"],
      "provides": ["doc_aadhaar_name", "doc_aadhaar_dob", "doc_aadhaar_gender", "doc_aadhaar_last4"],
      "spotting": false
    },
    {
      "id": "back",
      "name": { "English": "Back Side", "Hindi": "पीछे का हिस्सा" },
      "title": { "English": "back side", "Hindi": "पीछे का हिस्सा" },
      "anchors": ["Address", "S/O", "D/O", "W/O", "C/O", "PIN"],
      "provides": ["doc_aadhaar_address", "doc_aadhaar_last4"],
      "spotting": false
    }
  ],
  "sources": [
    { "type": "upload", "formats": ["image/jpeg", "image/png", "application/pdf"], "max_mb": 10 },
    { "type": "camera" }
  ],
  "ocr": { "lang": ["en", "hi"], "table_mode": false },
  "quality": {
    "min_box_confidence": 0.50,
    "min_anchor_hits": 2,
    "blur_var_min": 100
  },
  "preprocessing": ["auto_deskew", "remove_glare", "enhance_contrast"],
  "prompts": {
    "ask_part": {
      "en": "Please capture the {part_id} of your {document_title}.",
      "hi": "कृपया अपने {document_title} का {part_id} कैप्चर करें।"
    },
    "success": {
      "en": "Scanned successfully.",
      "hi": "सफलतापूर्वक स्कैन हो गया।"
    },
    "error_blur": {
      "en": "The image is blurry. Please hold the camera steady and try again.",
      "hi": "छवि धुंधली है। कृपया कैमरे को स्थिर रखें और पुनः प्रयास करें।"
    },
    "error_wrong_page": {
      "en": "This doesn't look like the expected page. Please check and try again.",
      "hi": "यह अपेक्षित पृष्ठ नहीं लगता। कृपया जाँचें और पुनः प्रयास करें।"
    },
    "error_low_confidence": {
      "en": "Some details are not clearly readable. Please retake the photo with better lighting.",
      "hi": "कुछ विवरण स्पष्ट रूप से पढ़ने योग्य नहीं हैं। कृपया बेहतर रोशनी में फिर से फोटो लें।"
    }
  },
  "checks": [],
  "copy_ref": "aadhaar"
}
