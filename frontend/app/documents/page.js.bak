'use client';

import { useState, useRef, useEffect, useCallback } from 'react';
import { useRouter } from 'next/navigation';
import styles from './documents.module.css';

const API_BASE_URL = process.env.NEXT_PUBLIC_API_URL || 'http://localhost:8080';
const WS_BASE_URL = process.env.NEXT_PUBLIC_WS_URL || 'ws://localhost:8080';
const SCHEME_ID = '72de6194-3c05-42a1-b0fb-a1c8e04a824e'; // Mudra Scheme

// Resample float32 buffer to 16000Hz (for STT)
function resample(buffer, sourceRate, targetRate) {
  const ratio = sourceRate / targetRate;
  const newLength = Math.round(buffer.length / ratio);
  const result = new Float32Array(newLength);
  let offsetResult = 0;
  let offsetBuffer = 0;
  while (offsetResult < result.length) {
    const nextOffsetBuffer = Math.round((offsetResult + 1) * ratio);
    let accum = 0, count = 0;
    for (let i = offsetBuffer; i < nextOffsetBuffer && i < buffer.length; i++) {
      accum += buffer[i];
      count++;
    }
    result[offsetResult] = count > 0 ? accum / count : 0;
    offsetResult++;
    offsetBuffer = nextOffsetBuffer;
  }
  return result;
}

// Convert Float32 array to 16-bit PCM ArrayBuffer
function floatTo16BitPCM(float32Array) {
  const buffer = new ArrayBuffer(float32Array.length * 2);
  const view = new DataView(buffer);
  for (let i = 0; i < float32Array.length; i++) {
    const s = Math.max(-1, Math.min(1, float32Array[i]));
    view.setInt16(i * 2, s < 0 ? s < 0x8000 : s * 0x7FFF, true);
  }
  return buffer;
}

export default function DocumentsPage() {
  const router = useRouter();

  // Basic Session Info
  const [token, setToken] = useState('');
  const [sessionId, setSessionId] = useState('');
  const [applicationId, setApplicationId] = useState('');

  // Core Flow Control
  const [activeStepId, setActiveStepId] = useState('selfie');

  // Global Audio Unlock on first interaction
  useEffect(() => {
    const unlock = () => {
      if (typeof window !== 'undefined') {
        window.globalAudioContext = window.globalAudioContext || new (window.AudioContext || window.webkitAudioContext)();
        const ctx = window.globalAudioContext;
        if (ctx.state === 'suspended') {
          try { ctx.resume(); } catch (e) {}
        }
        if (!window.audioUnlocked) {
          try {
            const buffer = ctx.createBuffer(1, ctx.sampleRate * 0.1, ctx.sampleRate);
            const source = ctx.createBufferSource();
            source.buffer = buffer;
            source.connect(ctx.destination);
            source.start(0);
            window.audioUnlocked = true;
          } catch(e) {}
        }
      }
      document.removeEventListener('click', unlock);
      document.removeEventListener('touchstart', unlock);
    };
    document.addEventListener('click', unlock);
    document.addEventListener('touchstart', unlock);
    return () => {
      document.removeEventListener('click', unlock);
      document.removeEventListener('touchstart', unlock);
    };
  }, []);

  const changeStep = (id) => {
    setActiveStepId(id);
  };
  const [isMarried, setIsMarried] = useState(false);

  // Guided Steps Config
  const getSteps = (isMarriedVal) => {
    const baseSteps = [
      { id: 'selfie', label: 'सेल्फी', icon: '🤳', type: 'capture', facingMode: 'user', tips: ['चेहरा साफ दिखे', 'अच्छी रोशनी हो', 'टोपी या चश्मा हटाएं'] },
      { id: 'aadhaar_front', label: 'आधार (आगे)', icon: '🪪', type: 'capture', facingMode: 'environment', tips: ['पूरा कार्ड दिखे', 'नंबर साफ हो', 'कटा हुआ न हो'] },
      { id: 'aadhaar_back', label: 'आधार (पीछे)', icon: '🪪', type: 'capture', facingMode: 'environment', tips: ['QR कोड साफ हो', 'पता साफ पढ़ा जा सके'] },
      { id: 'voice_qa', label: 'प्रश्नोत्तर', icon: '💬', type: 'voice-qa', tips: [] },
      { id: 'pan', label: 'पैन कार्ड', icon: '💳', type: 'capture', facingMode: 'environment', tips: ['पूरा पैन कार्ड फ्रेम में हो', 'नंबर साफ हो'] }
    ];

    if (isMarriedVal) {
      baseSteps.push({ id: 'spouse_pan', label: 'पति/पत्नी पैन', icon: '💳', type: 'capture', facingMode: 'environment', tips: ['पति या पत्नी का पैन कार्ड रखें', 'नंबर साफ हो'] });
    }

    baseSteps.push(
      { id: 'udyam', label: 'उद्यम प्रमाणपत्र', icon: '📜', type: 'capture', facingMode: 'environment', tips: ['पूरा उद्यम पत्र रखें', 'पंजीकरण नंबर साफ हो'] },
      { id: 'bank_statement', label: 'बैंक स्टेटमेंट', icon: '🏦', type: 'capture', facingMode: 'environment', tips: ['सभी पेज शामिल हों', 'अकाउंट नंबर दिखे'] },
      { id: 'review', label: 'समीक्षा', icon: '📋', type: 'review', tips: [] }
    );

    return baseSteps;
  };

  const steps = getSteps(isMarried);
  const activeStepIndex = steps.findIndex(s => s.id === activeStepId);
  const activeStep = steps[activeStepIndex] || steps[0];

  // Document Uploads State
  const [docs, setDocs] = useState({});
  const [verified, setVerified] = useState({});
  const [errors, setErrors] = useState({});
  const [verifying, setVerifying] = useState(null);

  // Extracted Data (Flat structure for review)
  const [extractedDetails, setExtractedDetails] = useState({
    full_name: '',
    aadhaar_number: '',
    pan_number: '',
    spouse_pan_number: '',
    udyam_number: '',
    enterprise_name: '',
    business_type: 'GROCERY',
    account_number: '',
    bank_name: '',
    ifsc_code: '',
    pincode: '',
    district: '',
    state: '',
    resident_address: '',
    spouse_phone: ''
  });


  const fileInputRef = useRef(null);
  const videoRef = useRef(null);
  const canvasRef = useRef(null);
  const streamRef = useRef(null);
  const [activeFacingMode, setActiveFacingMode] = useState('environment');


  // Voice Assistant Q&A State
  const [qaState, setQaState] = useState('idle'); // idle, connecting, listening, speaking, processing
  const [transcript, setTranscript] = useState('');
  const [qaChatHistory, setQaChatHistory] = useState([]);
  const [isClientSpeaking, setIsClientSpeaking] = useState(false);
  const [qaExtractedData, setQaExtractedData] = useState({});

  // Shared Voice Session Ref
  const voiceSessionRef = useRef(null);
  const [isUserSpeaking, setIsUserSpeaking] = useState(false);

  // Load Session Info on Mount & load VAD scripts
  useEffect(() => {
    const savedToken = localStorage.getItem('token');
    const savedSessionId = localStorage.getItem('session_id');
    const savedApplicationId = localStorage.getItem('application_id');
    if (!savedToken || !savedSessionId) {
      router.push('/');
    } else {
      setToken(savedToken);
      setSessionId(savedSessionId);
      setApplicationId(savedApplicationId || '');
    }

    // Load VAD dependencies from CDN
    import('../utils/voiceHelper').then(({ loadVADScripts }) => {
      loadVADScripts().then(success => {
        if (success) console.log('ONNX & VAD loaded successfully.');
        else console.warn('Failed to load VAD scripts.');
      });
    });
  }, [router]);

  // Handle Speech Prompts — uses our TTS service via gateway
  const speakQueueRef = useRef(Promise.resolve());
  const audioCtxRef = useRef(null);
  const currentSourceRef = useRef(null);
  const fetchControllerRef = useRef(null);

  const stopSpeaking = useCallback(() => {
    try {
      if (fetchControllerRef.current) {
        fetchControllerRef.current.abort();
        fetchControllerRef.current = null;
      }
      if (currentSourceRef.current) {
        currentSourceRef.current.onended = null;
        currentSourceRef.current.stop(0);
        currentSourceRef.current.disconnect();
        currentSourceRef.current = null;
      }
    } catch {}
    if ('speechSynthesis' in window) {
      try { window.speechSynthesis.cancel(); } catch {}
    }
    speakQueueRef.current = Promise.resolve();
  }, []);

  const speakPrompt = useCallback((text, langCode = 'hi-IN') => {
    if (!text || typeof text !== 'string') return Promise.resolve();
    stopSpeaking();

    const doSpeak = async () => {
      const controller = new AbortController();
      fetchControllerRef.current = controller;
      try {
        if (!audioCtxRef.current) {
          audioCtxRef.current = new (window.AudioContext || window.webkitAudioContext)();
        }
        const resp = await fetch(`${API_BASE_URL}/api/tts/synthesize`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text, languageCode: langCode }),
          signal: controller.signal,
        });
        if (!resp.ok) throw new Error('TTS error ' + resp.status);
        const ct = (resp.headers.get('content-type') || '').toLowerCase();
        if (ct.includes('application/json') || ct.includes('text/')) throw new Error('TTS non-audio');
        const ab = await resp.arrayBuffer();
        try {
          const audioBuffer = await audioCtxRef.current.decodeAudioData(ab.slice(0));
          if (currentSourceRef.current) {
            try { currentSourceRef.current.stop(0); currentSourceRef.current.disconnect(); } catch {}
          }
          const source = audioCtxRef.current.createBufferSource();
          source.buffer = audioBuffer;
          source.connect(audioCtxRef.current.destination);
          currentSourceRef.current = source;
          if (audioCtxRef.current.state === 'suspended') {
            try { await audioCtxRef.current.resume(); } catch {}
          }
          await new Promise(resolve => {
            source.onended = () => { currentSourceRef.current = null; resolve(); };
            try { source.start(0); } catch { resolve(); }
          });
        } catch {
          // Fallback: play as Audio element
          const blob = new Blob([ab], { type: 'audio/wav' });
          const url = URL.createObjectURL(blob);
          await new Promise(resolve => {
            const a = new Audio(url);
            a.onended = () => { URL.revokeObjectURL(url); resolve(); };
            a.onerror = () => { URL.revokeObjectURL(url); resolve(); };
            a.play().catch(() => resolve());
          });
        }
      } catch (err) {
        if (err.name === 'AbortError') return;
        console.warn('TTS service failed, falling back to browser speech:', err);
        // Fallback to browser speechSynthesis
        if ('speechSynthesis' in window) {
          try {
            window.speechSynthesis.cancel();
            await new Promise(resolve => {
              const utter = new SpeechSynthesisUtterance(text);
              utter.lang = langCode;
              utter.onend = () => resolve();
              utter.onerror = () => resolve();
              window.speechSynthesis.speak(utter);
            });
          } catch {}
        }
      } finally {
        fetchControllerRef.current = null;
      }
    };

    speakQueueRef.current = speakQueueRef.current
      .then(() => doSpeak())
      .catch(() => {});
    return speakQueueRef.current;
  }, [stopSpeaking]);

  const getStepSpeakText = (stepId) => {
    const prompts = {
      selfie: 'कृपया अपनी एक सेल्फी लें।',
      aadhaar_front: 'कृपया अपना आधार कार्ड सामने की तरफ रखें।',
      aadhaar_back: 'अब कृपया आधार कार्ड पीछे की तरफ रखें।',
      pan: 'कृपया अपना पैन कार्ड रखें।',
      spouse_pan: 'कृपया अपने पति या पत्नी का पैन कार्ड रखें।',
      udyam: 'कृपया अपना उद्यम प्रमाणपत्र रखें।',
      bank_statement: 'कृपया अपना बैंक स्टेटमेंट अपलोड करें या फ़ोटो लें।'
    };
    return prompts[stepId] || '';
  };

  // Native Camera Capture logic is handled directly via file input

  // Clean Voice Assistant context
  const cleanupQA = useCallback(() => {
    if (voiceSessionRef.current) {
      voiceSessionRef.current.disconnect();
      voiceSessionRef.current = null;
    }
    setIsUserSpeaking(false);
  }, []);

  // Voice Assistant Connection
  const startQASession = async () => {
    cleanupQA();
    setQaState('connecting');
    setQaChatHistory([
      { role: 'info', text: 'माइक और सर्वर से जुड़ रहे हैं...' },
      { role: 'system', text: 'नमस्ते! मैं आपकी लोन सत्यापन प्रक्रिया में सहायता करूंगी।' }
    ]);

    try {
      const { loadVADScripts, VoiceSessionManager } = await import('../utils/voiceHelper');
      const loaded = await loadVADScripts();
      if (!loaded) {
        throw new Error('VAD scripts could not be loaded.');
      }

      const manager = new VoiceSessionManager({
        token,
        sessionId,
        applicationId,
        applicantName: localStorage.getItem('applicant_name') || 'आवेदक',
        schemeId: 'documents-qa',
        wsUrl: `${WS_BASE_URL.replace('http', 'ws')}/ws/voice`,
        onStateChange: (state) => {
          setQaState(state);
        },
        onTranscript: (text, isFinal) => {
          if (!isFinal) {
            // This is assistant response text — show it as live status (like Hindi repo)
            setTranscript(text);
          }
          // Don't show user transcription at all (Hindi repo: onTranscription: () => {})
        },
        onExtraction: (fields) => {
          setQaExtractedData(prev => {
            const updated = { ...prev, ...fields };
            
            // Handle conditional stage trigger
            if (updated.is_married !== undefined) {
              const marriedBool = !!updated.is_married;
              setIsMarried(marriedBool);
              localStorage.setItem('is_married', marriedBool ? 'true' : 'false');
            }
            
            // Map Q&A fields to Flat Review State
            setExtractedDetails(prevDet => ({
              ...prevDet,
              is_married: updated.is_married !== undefined ? updated.is_married : prevDet.is_married,
              spouse_phone: updated.spouse_mobile || prevDet.spouse_phone,
              business_type: updated.business_purpose || prevDet.business_type
            }));

            return updated;
          });
        },
        onComplete: (data) => {
          setQaChatHistory(prev => [...prev, { role: 'info', text: '✅ प्रश्नोत्तर सफलतापूर्वक पूर्ण हुआ!' }]);
          cleanupQA();
          
          // Auto advance
          setTimeout(() => {
            changeStep('pan');
          }, 2000);
        },
        onSystemMessage: (role, text) => {
          setQaChatHistory(prev => [...prev, { role, text }]);
        },
        onError: (err) => {
          console.warn('Voice session error:', err);
        }
      });

      voiceSessionRef.current = manager;

      await manager.connect();

      // Hook VAD speech triggers to our React state
      if (manager.vadInstance) {
        const originalOnSpeechStart = manager.vadInstance.options.onSpeechStart;
        manager.vadInstance.options.onSpeechStart = () => {
          setIsUserSpeaking(true);
          originalOnSpeechStart();
        };

        const originalOnSpeechEnd = manager.vadInstance.options.onSpeechEnd;
        manager.vadInstance.options.onSpeechEnd = () => {
          setIsUserSpeaking(false);
          originalOnSpeechEnd();
        };
      }

    } catch (err) {
      console.error('Failed to initialize microphone / VAD / WS connection:', err);
      setQaChatHistory(prev => [...prev, { role: 'system', text: 'माइक अनुमति अस्वीकार कर दी गई है या सर्वर अनुपलब्ध है।' }]);
      setQaState('idle');
      cleanupQA();
    }
  };

  // State Step Machine Effect Trigger
  useEffect(() => {
    const currentSteps = getSteps(isMarried);
    const stepObj = currentSteps.find(s => s.id === activeStepId);

    // Cancel system speech when changing step
    stopSpeaking();

    // No WebRTC cleanup needed since we use native input

    let timeoutId;
    if (activeStepId === 'voice_qa') {
      timeoutId = setTimeout(() => {
        startQASession();
      }, 1500);
    } else {
      cleanupQA();
    }

    const text = getStepSpeakText(activeStepId);
    if (text) {
      speakPrompt(text);
    }

    return () => {
      clearTimeout(timeoutId);
      cleanupQA();
    };
  }, [activeStepId, token, sessionId]);


  const stopCamera = useCallback(() => {
    if (streamRef.current) {
      streamRef.current.getTracks().forEach(t => t.stop());
      streamRef.current = null;
    }
  }, []);

  const startCamera = useCallback(async (facingMode) => {
    stopCamera();
    try {
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode, width: { ideal: 1280 }, height: { ideal: 720 } }
      });
      streamRef.current = stream;
      if (videoRef.current) {
        videoRef.current.srcObject = stream;
        videoRef.current.play().catch(e => console.error(e));
      }
    } catch (err) {
      console.error('Camera access error:', err);
    }
  }, [stopCamera]);

  const handleCapture = () => {
    if (videoRef.current && canvasRef.current) {
      const video = videoRef.current;
      const canvas = canvasRef.current;
      canvas.width = video.videoWidth || 640;
      canvas.height = video.videoHeight || 480;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
      
      canvas.toBlob(blob => {
        if (blob) {
          const file = new File([blob], `${activeStepId}.jpg`, { type: 'image/jpeg' });
          handleUploadedFile(file);
        }
      }, 'image/jpeg', 0.8);
    }
  };

  useEffect(() => {
    if (activeStep.type === 'capture') {
      startCamera(activeFacingMode);
    } else {
      stopCamera();
    }
    return () => stopCamera();
  }, [activeStep.type, activeFacingMode, startCamera, stopCamera]);

  // Flip camera handle
  const handleFlipCamera = () => {
    const newMode = activeFacingMode === 'user' ? 'environment' : 'user';
    setActiveFacingMode(newMode);
    startCamera(newMode);
  };

  // Fallback Upload from Filesystem
  const handleFileClick = () => {
    fileInputRef.current?.click();
  };

  const handleFileChange = async (e) => {
    const file = e.target.files?.[0];
    if (file) {
      await handleUploadedFile(file);
      e.target.value = ''; // Reset
    }
  };

  // Core Verify/Extract Call
  const handleUploadedFile = async (file) => {
    setVerifying(activeStepId);
    setErrors(prev => ({ ...prev, [activeStepId]: '' }));

    const previewUrl = URL.createObjectURL(file);
    setDocs(prev => ({ ...prev, [activeStepId]: { file, url: previewUrl, name: file.name } }));

    const formData = new FormData();
    formData.append('file', file);
    formData.append('document_type', activeStepId);
    formData.append('scheme_id', SCHEME_ID);
    formData.append('session_id', sessionId);

    try {
      // 1. Verify document
      const verifyRes = await fetch(`${API_BASE_URL}/api/documents/verify`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`
        },
        body: formData
      });
      const verifyData = await verifyRes.json();
      if (!verifyData.is_valid) {
        const issuesMsg = verifyData.issues?.join(', ') || 'दस्तावेज़ अमान्य है।';
        throw new Error(issuesMsg);
      }

      // 2. Extract data
      const extractRes = await fetch(`${API_BASE_URL}/api/documents/extract`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`
        },
        body: formData
      });
      const extractData = await extractRes.json();
      if (!extractData.success) {
        throw new Error(extractData.error || 'डेटा निकालने में विफल।');
      }

      const jsonFields = extractData.json_data || {};
      
      // Update details structure
      updateFlatDetailsFromExtraction(activeStepId, jsonFields);

      setVerified(prev => ({ ...prev, [activeStepId]: { valid: true, confidence: verifyData.confidence } }));
      
      // Voice feedback
      const feedback = {
        selfie: 'सेल्फी सत्यापित हो गई। धन्यवाद।',
        aadhaar_front: 'आधार कार्ड का अगला भाग सत्यापित हो गया।',
        aadhaar_back: 'आधार कार्ड का पिछला भाग सत्यापित हो गया।',
        pan: 'पैन कार्ड सफलतापूर्वक सत्यापित हो गया।',
        spouse_pan: 'पति या पत्नी का पैन कार्ड सत्यापित हो गया।',
        udyam: 'उद्यम प्रमाणपत्र सफलतापूर्वक सत्यापित हो गया।',
        bank_statement: 'बैंक स्टेटमेंट सफलतापूर्वक सत्यापित हो गया।'
      };
      if (feedback[activeStepId]) {
        await speakPrompt(feedback[activeStepId]);
      } else {
        await new Promise(resolve => setTimeout(resolve, 1000));
      }
      handleNext();

    } catch (err) {
      setErrors(prev => ({ ...prev, [activeStepId]: err.message }));
      setVerified(prev => ({ ...prev, [activeStepId]: { valid: false } }));
      speakPrompt('त्रुटि हुई। कृपया स्पष्ट फोटो दोबारा अपलोड करें।');
    } finally {
      setVerifying(null);
    }
  };

  const updateFlatDetailsFromExtraction = (docId, json) => {
    setExtractedDetails(prev => {
      const copy = { ...prev };
      if (docId === 'aadhaar_front') {
        copy.full_name = json.holder?.full_name || copy.full_name;
        copy.aadhaar_number = json.aadhaar_number || copy.aadhaar_number;
      } else if (docId === 'aadhaar_back') {
        copy.pincode = json.address?.pincode || copy.pincode;
        copy.state = json.address?.state || copy.state;
        copy.district = json.address?.district || copy.district;
        copy.resident_address = json.address?.full_address || copy.resident_address;
      } else if (docId === 'pan') {
        copy.pan_number = json.pan_number || copy.pan_number;
        if (!copy.full_name) {
          copy.full_name = json.holder?.full_name || '';
        }
      } else if (docId === 'spouse_pan') {
        copy.spouse_pan_number = json.pan_number || copy.spouse_pan_number;
      } else if (docId === 'udyam') {
        copy.udyam_number = json.udyam_number || copy.udyam_number;
        copy.enterprise_name = json.enterprise?.enterprise_name || copy.enterprise_name;
        copy.business_type = json.enterprise?.business_type || copy.business_type;
      } else if (docId === 'bank_statement') {
        copy.account_number = json.account_details?.account_number || copy.account_number;
        copy.bank_name = json.account_details?.bank_name || copy.bank_name;
        copy.ifsc_code = json.account_details?.ifsc_code || copy.ifsc_code;
      }
      return copy;
    });
  };

  const handleNextStep = () => {
    const currentSteps = getSteps(isMarried);
    const currentIndex = currentSteps.findIndex(s => s.id === activeStepId);
    if (currentIndex !== -1 && currentIndex < currentSteps.length - 1) {
      changeStep(currentSteps[currentIndex + 1].id);
    }
  };

  const handlePrevStep = () => {
    const currentSteps = getSteps(isMarried);
    const currentIndex = currentSteps.findIndex(s => s.id === activeStepId);
    if (currentIndex > 0) {
      changeStep(currentSteps[currentIndex - 1].id);
    }
  };

  // Save reviewed fields and proceed to voice interview
  const handleFinalSubmit = async () => {
    setVerifying('review');
    try {
      // 1. Save all extracted details to DB
      const saveRes = await fetch(`${API_BASE_URL}/api/applications/save-metadata`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({
          session_id: sessionId,
          fields: extractedDetails
        })
      });
      const saveData = await saveRes.json();
      if (!saveData.success) {
        throw new Error(saveData.error || 'समीक्षा विवरण सहेजने में विफल।');
      }

      // 2. Advance stage to INTERVIEW in DB
      await fetch(`${API_BASE_URL}/api/applications/advance-stage`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({
          application_id: sessionId,
          new_stage: 'INTERVIEW'
        })
      });

      // 3. Move to interview route
      router.push(`/interview?name=${encodeURIComponent(extractedDetails.full_name)}&type=${encodeURIComponent(extractedDetails.business_type)}`);
    } catch (err) {
      alert(`सहेजने में विफलता: ${err.message}`);
    } finally {
      setVerifying(null);
    }
  };

  const completedRequired = steps
    .filter(d => d.type === 'capture')
    .every(d => verified[d.id]?.valid);

  return (
    <div className={styles.container}>
      {/* Header */}
      <header className={styles.header}>
        <button className="btn btn-ghost" onClick={() => router.back()} id="back-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
          वापस
        </button>
        <div>
          <h1 style={{ fontSize: '1.25rem', textAlign: 'center', fontWeight: '700', color: 'var(--text-primary)' }}>📄 दस्तावेज़ सत्यापन एवं सहायक</h1>
        </div>
        <div className={styles.headerStats}>
          <span className="badge badge-success">
            {Object.keys(verified).filter(k => verified[k]?.valid).length} सत्यापित
          </span>
        </div>
      </header>

      {/* Progress Chips */}
      <div className={styles.progressSection}>
        <div className={styles.progressSteps}>
          {steps.map((s, idx) => {
            const isDone = verified[s.id]?.valid || (s.id === 'voice_qa' && Object.keys(qaExtractedData).length > 0);
            const isActive = s.id === activeStepId;
            return (
              <div
                key={s.id}
                className={`${styles.stepChip} ${isActive ? styles.stepChipActive : ''} ${isDone ? styles.stepChipDone : ''}`}
                onClick={() => changeStep(s.id)}
              >
                <span className={styles.chipIcon}>{isDone ? '✅' : s.icon}</span>
                <span className={styles.chipText}>{s.label}</span>
              </div>
            );
          })}
        </div>
      </div>

      {/* Main Layout Grid */}
      <div className={styles.mainGrid}>
        
        {/* Left Column: WebRTC Camera / Upload Panel */}
        <div className={`${styles.leftPanel} ${activeStep.type !== 'capture' ? styles.panelHidden : ''}`}>

          <div className={styles.videoContainer}>
            {activeStep.type === 'capture' && !docs[activeStepId] && (
              <div style={{ position: 'relative', width: '100%', height: '100%' }}>
                <video
                  ref={videoRef}
                  autoPlay
                  playsInline
                  muted
                  className={styles.cameraPreview}
                  style={{ width: '100%', height: '100%', objectFit: 'cover' }}
                />
                <div className={styles.cameraControlsOverlay} style={{ position: 'absolute', bottom: '20px', left: 0, right: 0, display: 'flex', justifyContent: 'center', gap: '1rem' }}>
                  <button className="btn btn-secondary" onClick={handleFlipCamera} style={{ borderRadius: '50%', width: '50px', height: '50px', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                    🔄
                  </button>
                  <button className="btn btn-primary" onClick={handleCapture} style={{ borderRadius: '50px', padding: '0 24px', fontWeight: 'bold' }}>
                    📸 फोटो लें
                  </button>
                </div>
              </div>
            )}
            
            {docs[activeStepId] && (
              <img src={docs[activeStepId].url} alt="Captured preview" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
            )}

            <div style={{ display: 'none' }}>
              <canvas ref={canvasRef} />
            </div>

            {/* Hidden Input for Native Camera/File Dialog */}
            <input
              type="file"
              accept="image/*,application/pdf"
              ref={fileInputRef}
              style={{ display: 'none' }}
              onChange={handleFileChange}
            />

            {/* Fallback File Browse inside the view when NOT captured yet */}
            {activeStep.type === 'capture' && !docs[activeStepId] && (
               <div style={{ position: 'absolute', top: '10px', right: '10px' }}>
                 <button className="btn btn-secondary btn-sm" onClick={handleFileClick}>
                   📁 फ़ाइल चुनें
                 </button>
               </div>
            )}


            {/* Verification Scanning overlay */}
            {verifying === activeStepId && (
              <div className={styles.scanningOverlay}>
                <div className={styles.scanLine} />
                <p>AI दस्तावेज़ की जाँच कर रहा है...</p>
              </div>
            )}
          </div>
        </div>

        {/* Right Column: Step Description / Voice Assistant Q&A / Review */}
        <div className={styles.rightPanel}>
          
          {/* A. Capture Step Instruction Card */}
          {activeStep.type === 'capture' && (
            <div className={styles.detailCard}>
              <div className={styles.cardHeader}>
                <span className={styles.cardIconLarge}>{activeStep.icon}</span>
                <div>
                  <h3 className={styles.cardTitle}>{activeStep.label}</h3>
                  <p className={styles.cardDesc}>{activeStep.tips[0] || 'दस्तावेज़ की साफ़ फ़ोटो खींचें'}</p>
                </div>
              </div>

              <div className={styles.instructionBody}>
                <h4 style={{ fontWeight: '600', marginBottom: '8px' }}>दिशानिर्देश:</h4>
                <ul className={styles.tipsList}>
                  {activeStep.tips.map((tip, index) => (
                    <li key={index} className={styles.tipItem}>
                      <span className={styles.checkMarker}>•</span>
                      {tip}
                    </li>
                  ))}
                </ul>

                {docs[activeStep.id] && (
                  <div className={styles.uploadedDocPreviewSection}>
                    <p style={{ fontSize: '0.875rem', fontWeight: '600', color: 'var(--text-secondary)' }}>अपलोड किया गया दस्तावेज़:</p>
                    <img
                      src={docs[activeStep.id].url}
                      alt="Uploaded preview"
                      className={styles.uploadedThumbnail}
                    />
                    <div style={{ marginTop: '6px' }}>
                      {verified[activeStep.id]?.valid ? (
                        <span className="badge badge-success">✓ सत्यापित</span>
                      ) : errors[activeStep.id] ? (
                        <span className="badge badge-danger">त्रुटि: {errors[activeStep.id]}</span>
                      ) : (
                        <span className="badge badge-warning">जांच लंबित</span>
                      )}
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}

          {/* B. Voice Q&A Assistant Step Pane — Hindi-style Neural Core UI */}
          {activeStep.id === 'voice_qa' && (
            <div className={styles.neuralCoreContainer}>
              {/* Connection Indicator */}
              <div className={styles.connectionBar}>
                <div className={`${styles.connectionDot} ${qaState !== 'idle' ? styles.connected : ''}`} />
                <span className={styles.connectionText}>
                  {qaState === 'idle' ? 'Standby' :
                   qaState === 'connecting' ? 'Connecting...' :
                   isUserSpeaking ? 'आप बोल रहे हैं...' :
                   qaState === 'listening' ? 'सुन रहे हैं...' :
                   qaState === 'speaking' ? 'AI बोल रहा है...' :
                   qaState === 'processing' ? 'Processing...' :
                   'Connected'}
                </span>
              </div>

              {/* Title */}
              <div className={styles.neuralTitle}>
                <h2 className={styles.neuralH2}>
                  Mudra <span className={styles.neuralAccent}>AI</span>
                </h2>
                {/* Live AI text — exactly like Hindi's #callStatus */}
                <div className={`${styles.callStatusText} ${qaState !== 'idle' ? styles.callActive : ''}`}>
                  {transcript || (
                    qaState === 'idle' ? 'बातचीत शुरू करें' :
                    qaState === 'connecting' ? 'सर्वर से जुड़ रहे हैं...' :
                    qaState === 'processing' ? '...' :
                    qaState === 'listening' ? 'बोलिये...' :
                    'सुन रहे हैं...'
                  )}
                </div>
              </div>

              {/* Neural Core Orb */}
              <div className={styles.neuralCoreWrapper}>
                {/* Orbiting Rings */}
                <div className={`${styles.coreRing} ${styles.ring1} ${qaState !== 'idle' ? styles.ringActive : ''}`} />
                <div className={`${styles.coreRing} ${styles.ring2} ${qaState !== 'idle' ? styles.ringActive : ''}`} />
                <div className={`${styles.coreRing} ${styles.ring3} ${qaState !== 'idle' ? styles.ringActive : ''}`} />

                {/* The Core Sphere */}
                <div className={`${styles.coreSphere} ${
                  isUserSpeaking ? styles.sphereListening :
                  qaState === 'speaking' ? styles.sphereSpeaking :
                  qaState === 'processing' ? styles.sphereProcessing :
                  qaState !== 'idle' ? styles.sphereActive : ''
                }`}>
                  <div className={styles.coreGlowInner} />
                  {/* AI Logo */}
                  <svg viewBox="0 0 40 40" fill="none" className={styles.aiLogo}>
                    <circle cx="20" cy="20" r="18" stroke="rgba(255,255,255,0.8)" strokeWidth="2"/>
                    <path d="M14 20C14 16.6863 16.6863 14 20 14C23.3137 14 26 16.6863 26 20" stroke="rgba(255,255,255,0.8)" strokeWidth="2" strokeLinecap="round"/>
                    <circle cx="20" cy="24" r="2" fill="rgba(255,255,255,0.8)"/>
                  </svg>
                </div>
              </div>

              {/* Controls */}
              <div className={styles.neuralControls}>
                {qaState === 'idle' ? (
                  <button
                    className={styles.btnNeural}
                    onClick={startQASession}
                    data-state="start"
                  >
                    <span>Initiate Connection</span>
                    <div className={styles.btnGlow} />
                  </button>
                ) : (
                  <button
                    className={styles.btnNeural}
                    onClick={cleanupQA}
                    data-state="end"
                  >
                    <span>End Session</span>
                    <div className={styles.btnGlow} />
                  </button>
                )}
              </div>
            </div>
          )}

          {/* C. Final Form Review Step Pane */}
          {activeStep.id === 'review' && (
            <div className={styles.reviewCard}>
              <h3>📋 आवेदन विवरण समीक्षा</h3>
              <p className="text-sm text-muted" style={{ marginBottom: '16px' }}>
                कृपया जानकारी की समीक्षा करें और आवश्यकतानुसार संपादन करें।
              </p>

              <div className={styles.reviewForm}>
                <div className={styles.formGroup}>
                  <label>आवेदक का पूरा नाम</label>
                  <input
                    type="text"
                    value={extractedDetails.full_name}
                    onChange={(e) => setExtractedDetails({ ...extractedDetails, full_name: e.target.value })}
                  />
                </div>

                <div className={styles.formRow}>
                  <div className={styles.formGroup}>
                    <label>आधार संख्या</label>
                    <input
                      type="text"
                      maxLength="12"
                      value={extractedDetails.aadhaar_number}
                      onChange={(e) => setExtractedDetails({ ...extractedDetails, aadhaar_number: e.target.value })}
                    />
                  </div>
                  <div className={styles.formGroup}>
                    <label>पैन कार्ड संख्या</label>
                    <input
                      type="text"
                      maxLength="10"
                      value={extractedDetails.pan_number}
                      onChange={(e) => setExtractedDetails({ ...extractedDetails, pan_number: e.target.value })}
                    />
                  </div>
                </div>

                {isMarried && (
                  <div className={styles.formRow}>
                    <div className={styles.formGroup}>
                      <label>पति/पत्नी पैन संख्या</label>
                      <input
                        type="text"
                        maxLength="10"
                        value={extractedDetails.spouse_pan_number}
                        onChange={(e) => setExtractedDetails({ ...extractedDetails, spouse_pan_number: e.target.value })}
                      />
                    </div>
                    <div className={styles.formGroup}>
                      <label>पति/पत्नी मोबाइल संख्या</label>
                      <input
                        type="text"
                        maxLength="10"
                        value={extractedDetails.spouse_phone}
                        onChange={(e) => setExtractedDetails({ ...extractedDetails, spouse_phone: e.target.value })}
                      />
                    </div>
                  </div>
                )}

                <div className={styles.formRow}>
                  <div className={styles.formGroup}>
                    <label>उद्यम पंजीकरण संख्या</label>
                    <input
                      type="text"
                      value={extractedDetails.udyam_number}
                      onChange={(e) => setExtractedDetails({ ...extractedDetails, udyam_number: e.target.value })}
                    />
                  </div>
                  <div className={styles.formGroup}>
                    <label>व्यवसाय का प्रकार</label>
                    <select
                      value={extractedDetails.business_type}
                      onChange={(e) => setExtractedDetails({ ...extractedDetails, business_type: e.target.value })}
                    >
                      <option value="GROCERY">किराना / Grocery</option>
                      <option value="CLOTHING">कपड़ा / Clothing</option>
                      <option value="DAIRY">डेयरी / Dairy</option>
                      <option value="SALON">सैलून / Salon</option>
                      <option value="FURNITURE">फर्नीचर / Furniture</option>
                      <option value="GARAGE">गैराज / Garage</option>
                      <option value="TAILOR">दर्जी / Tailor</option>
                    </select>
                  </div>
                </div>

                <div className={styles.formGroup}>
                  <label>व्यवसाय / उद्यम का नाम</label>
                  <input
                    type="text"
                    value={extractedDetails.enterprise_name}
                    onChange={(e) => setExtractedDetails({ ...extractedDetails, enterprise_name: e.target.value })}
                  />
                </div>

                <div className={styles.formRow}>
                  <div className={styles.formGroup}>
                    <label>बैंक खाता संख्या</label>
                    <input
                      type="text"
                      value={extractedDetails.account_number}
                      onChange={(e) => setExtractedDetails({ ...extractedDetails, account_number: e.target.value })}
                    />
                  </div>
                  <div className={styles.formGroup}>
                    <label>IFSC कोड</label>
                    <input
                      type="text"
                      value={extractedDetails.ifsc_code}
                      onChange={(e) => setExtractedDetails({ ...extractedDetails, ifsc_code: e.target.value })}
                    />
                  </div>
                </div>

                <div className={styles.formRow}>
                  <div className={styles.formGroup}>
                    <label>पिन कोड</label>
                    <input
                      type="text"
                      maxLength="6"
                      value={extractedDetails.pincode}
                      onChange={(e) => setExtractedDetails({ ...extractedDetails, pincode: e.target.value })}
                    />
                  </div>
                  <div className={styles.formGroup}>
                    <label>ज़िला</label>
                    <input
                      type="text"
                      value={extractedDetails.district}
                      onChange={(e) => setExtractedDetails({ ...extractedDetails, district: e.target.value })}
                    />
                  </div>
                  <div className={styles.formGroup}>
                    <label>राज्य</label>
                    <input
                      type="text"
                      value={extractedDetails.state}
                      onChange={(e) => setExtractedDetails({ ...extractedDetails, state: e.target.value })}
                    />
                  </div>
                </div>

                <div className={styles.formGroup}>
                  <label>पता (Address)</label>
                  <textarea
                    rows="2"
                    value={extractedDetails.resident_address}
                    onChange={(e) => setExtractedDetails({ ...extractedDetails, resident_address: e.target.value })}
                  />
                </div>
              </div>

              <div style={{ marginTop: '20px' }}>
                <button
                  className="btn btn-primary btn-lg"
                  onClick={handleFinalSubmit}
                  disabled={verifying === 'review'}
                  style={{ width: '100%', borderRadius: '12px' }}
                >
                  {verifying === 'review' ? 'सहेज रहे हैं...' : 'सहेजें और इंटरव्यू शुरू करें ➔'}
                </button>
              </div>
            </div>
          )}

          {/* Stepper Wizard Control buttons */}
          {activeStep.id !== 'review' && (
            <div className={styles.flowNavigation}>
              <button
                className="btn btn-secondary"
                onClick={handlePrevStep}
                disabled={activeStepIndex === 0}
              >
                ← पिछला
              </button>
              <button
                className="btn btn-secondary"
                onClick={handleNextStep}
                disabled={activeStepIndex === steps.length - 1}
              >
                अगला →
              </button>
            </div>
          )}
          
        </div>
      </div>


    </div>
  );
}
